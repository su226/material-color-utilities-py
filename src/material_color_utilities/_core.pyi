from collections.abc import Buffer
from typing import Any, Final, Protocol

type _RGB = tuple[int, int, int]
type _LinearRGB = tuple[float, float, float]
type _XYZ = tuple[float, float, float]
type _Lab = tuple[float, float, float]

class _SupportsArrow(Protocol):
    def __arrow_c_schema__(self) -> Any: ...
    def __arrow_c_array__(
        self,
        requested_schema: Any | None = None,
    ) -> tuple[Any, Any]: ...

# blend

def harmonize(design_color: _RGB, source_color: _RGB) -> _RGB: ...
def hct_hue(from_: _RGB, to: _RGB, amount: float) -> _RGB: ...
def cam16_ucs(from_: _RGB, to: _RGB, amount: float) -> _RGB: ...

# color

SRGB_TO_XYZ: list[list[float]]
"""sRGB to CIE XYZ 3x3 matrix."""

XYZ_TO_SRGB: list[list[float]]
"""CIE XYZ to sRGB 3x3 matrix."""

WHITE_POINT_D65: list[float]
"""White point D65 in CIE XYZ."""

def linear_rgb_to_rgb(linear_rgb: _LinearRGB) -> _RGB:
    """Converts linear RGB to sRGB."""

def xyz_to_rgb(xyz: _XYZ) -> _RGB:
    """Converts CIE XYZ to sRGB."""

def rgb_to_xyz(rgb: _RGB) -> _XYZ:
    """Converts sRGB to CIE XYZ."""

def lab_to_rgb(lab: _Lab) -> _RGB:
    """Converts CIE Lab to sRGB."""

def rgb_to_lab(rgb: _RGB) -> _Lab:
    """Converts sRGB to CIE Lab."""

def hex_to_rgb(hex: str) -> _RGB:
    """
    Unpack 3 or 6 hexdecimal digits to RGB, with or without leading #.
    :raises ValueError: When format is invalid.
    """

def int_to_rgb(value: int) -> _RGB:
    """Unpack uint32 in ARGB order to RGB."""

def lstar_to_rgb(lstar: float) -> _RGB:
    """
    Converts an L* value to an Rgb representation.
    :param lstar: L* in L*a*b*
    :return: RGB representation of grayscale color with lightness matching L*
    """

def rgb_to_lstar(rgb: _RGB) -> float:
    """
    Computes the L* value of a color in Rgb representation.
    :return" L*, from L*a*b*, coordinate of the color
    """

def rgb_to_int(rgb: _RGB) -> int:
    """Pack RGB to uint32, in 0x00RRGGBB format."""

def rgb_to_argb_int(rgb: _RGB) -> int:
    """Pack RGB to uint32, in 0xFFRRGGBB format."""

def rgb_to_hex(rgb: _RGB) -> str:
    """Pack RGB to 6-digit hexdecimal string, without leading #."""

def y_from_lstar(lstar: float) -> float:
    """
    Converts an L* value to a Y value.

    L* in L*a*b* and Y in XYZ measure the same quantity, luminance.

    L* measures perceptual luminance, a linear scale. Y in XYZ measures relative
    luminance, a logarithmic scale.

    :param lstar: L* in L*a*b*
    :return: Y in XYZ
    """

def lstar_from_y(y: float) -> float:
    """
    Converts a Y value to an L* value.

    L* in L*a*b* and Y in XYZ measure the same quantity, luminance.

    L* measures perceptual luminance, a linear scale. Y in XYZ measures relative
    luminance, a logarithmic scale.

    :param y: Y in XYZ
    :return: L* in L*a*b*
    """

def linearized(rgb_component: int) -> float:
    """
    Linearizes an Rgb component.

    :param rgb_component: 0 <= `rgb_component` <= 255, represents R/G/B channel
    :return: 0.0 <= output <= 100.0, color channel converted to linear Rgb space
    """

def delinearized(rgb_component: float) -> int:
    """
    Delinearizes an Rgb component.

    :param rgb_component: 0.0 <= `rgb_component` <= 100.0, represents linear R/G/B channel
    :return: 0 <= output <= 255, color channel converted to regular Rgb space
    """

